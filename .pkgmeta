package-as: MythicPlusTimer

enable-nolib-creation: no

# The packager only looks for the .toc at the repo root. This lifts the addon
# folder up one level in the built package, and is how the packager finds it.
move-folders:
  MythicPlusTimer/MythicPlusTimer: MythicPlusTimer

# Only the addon folder ships. node_modules is not in the repo, but the release
# job runs `npm ci` before packaging, so it is in the workspace by then.
ignore:
  - .github
  - scripts
  - test
  - node_modules
  - README.md
  - package.json
  - package-lock.json
  - .gitattributes
  - .pkgmeta
